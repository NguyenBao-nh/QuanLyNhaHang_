@model List<HuyMon>
@{
    ViewData["Title"] = "Lịch Sử Hủy Món";
    Layout = "~/Views/Shared/layout_admin.cshtml";
    var tenNV = ViewBag.TenNV as Dictionary<string, string> ?? new Dictionary<string, string>();
    string? ngay = ViewBag.Ngay as string;
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="color: #f49030">Lịch Sử Hủy Món</h2>
        <a asp-action="DanhSachPhieuGoiMon" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Phiếu gọi món</a>
    </div>

    <form asp-action="LichSuHuyMon" method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label">Xem theo ngày</label>
            <input type="date" name="ngay" value="@ngay" class="form-control" />
        </div>
        <div class="col-md-2 d-grid"><button type="submit" class="btn btn-primary">Lọc</button></div>
        <div class="col-md-6 text-muted small">@(ngay == null ? "Đang xem 7 ngày gần nhất." : "")</div>
    </form>

    <p>Tổng: <strong>@Model.Sum(h => h.Soluong)</strong> phần bị hủy, <strong>@Model.Count</strong> lượt hủy.</p>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Thời gian</th>
                <th>Phiếu</th>
                <th>Bàn</th>
                <th>Món</th>
                <th class="text-center">Số lượng</th>
                <th>Lý do</th>
                <th>Nhân viên</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted">Không có món nào bị hủy.</td></tr>
            }
            @foreach (var h in Model)
            {
                <tr>
                    <td>@h.Thoigian.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@h.Mapgm.Trim()</td>
                    <td>@h.Maban?.Trim()</td>
                    <td>@(h.Tenmon ?? h.Mamonan.Trim())</td>
                    <td class="text-center">@h.Soluong</td>
                    <td>@h.Lydo</td>
                    <td>@(string.IsNullOrWhiteSpace(h.Manv) ? "-" : (tenNV.TryGetValue(h.Manv.Trim(), out var t) ? t : h.Manv.Trim()))</td>
                </tr>
            }
        </tbody>
    </table>
</div>
