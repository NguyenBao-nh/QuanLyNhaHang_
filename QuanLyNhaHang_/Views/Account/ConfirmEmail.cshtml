@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác Nhận Email Thành Công</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-success text-white text-center">
                        <h4>Xác nhận email thành công!</h4>
                    </div>
                    <div class="card-body text-center">
                        <p>Bạn có thể đăng nhập ngay lúc này</p>
                        <a href="@Url.Action("DangNhap", "Account")" class="btn btn-primary">Đăng Nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
            @if (TempData["Message"] != null)
            {
                    <text>
                            Swal.fire({
                                title: 'Tài Khoản đã được xác thực thành công!',
                                icon: 'success',
                                showConfirmButton: false,
                                timer: 3000
                            }).then(function () {
                                window.location.href = '@Url.Action("DangNhap", "Account")';
                            });
                    </text>
            }
    </script>
</body>
</html>