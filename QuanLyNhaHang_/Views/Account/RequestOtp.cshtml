@model QuanLyNhaHang_.Models.TaiKhoan
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yêu Cầu Mã OTP</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        * { box-sizing: border-box; }
        html { font-size: 62.5%; }
        body { font-size: 1.6rem; font-family: "Roboto", sans-serif; margin: 0; padding: 0; }
        header {
            background-image: url("/Images/bg-dark.jpg");
            color: white;
            display: flex;
            min-height: calc(100vh - 10rem);
            background-size: cover;
            background-position: center center;
            flex-direction: column;
            align-items: flex-start;
        }
        header .content { margin: auto; font-size: 2rem; }
        header .content h1 { font-size: 3rem; margin-bottom: 3rem; font-weight: bold; color: #00c2ff; }
        header .content p { margin-bottom: 2rem; }
        a { text-decoration: none; color: white; }
        .container { margin: 0 auto; max-width: 100%; width: 100rem; }
        nav { display: flex; justify-content: space-between; padding: 1rem; align-items: baseline; }
        nav ul { display: flex; list-style-type: none; padding: 0; }
        nav li a { padding: 1rem; }
        .selected { font-weight: bold; }
        .highlight { background-color: #00c2ff; padding: 1rem; border-radius: 5px; }
        footer { height: 10rem; background-color: #000; color: #fff; padding: 1rem; }
        footer ul { display: flex; list-style-type: none; align-items: center; justify-content: space-between; padding: 0; }
        footer strong { color: #00c2ff; line-height: 2; }
        ul, li { margin: 0; padding: 0; }
        .form-control { border-radius: 50px; padding: 10px 15px; border: none; box-shadow: 0 0 8px gray; font-size: 1.6rem; }
        .btn { background-color: #00c3fd; border: none; padding: 10px 25px; border-radius: 15px; color: white; font-weight: bold; font-size: 1.6rem; }
        .text-danger { color: #ff4d4d; font-size: 1.4rem; font-weight: bold; }
    </style>
</head>
<body>
    <header>
        <nav class="container" style="display: flex; align-items: center">
            <ul>
                <li><a href="@Url.Action("Welcome", "Account")" class="selected">Trang chủ</a></li>
                <li><a href="@Url.Action("Menu", "MonAn")">Nổi bật</a></li>
                <li><a href="@Url.Action("Menu", "MonAn")">Giá</a></li>
                <li><a href="@Url.Action("Welcome", "Account")#footer">Liên hệ</a></li>
                <li><a href="@Url.Action("DatBan1", "DatBan")" class="highlight">Đặt bàn</a></li>
            </ul>
        </nav>
        <div class="content">
            <div class="container">
                <h1>Thay đổi mật khẩu!</h1>
                <p>Nhập email đã đăng ký để nhận mã OTP</p>
                <form asp-controller="Account" asp-action="RequestOtp" method="post">
                    <div class="mb-3">
                        <label class="form-label">Nhập địa chỉ email:</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email của bạn" id="email" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary mt-2">Yêu cầu mã OTP</button>
                </form>
            </div>
        </div>
    </header>

    <footer>
        <ul class="container">
            <li>
                <strong>Địa Chỉ</strong>
                <p>88 Láng Hạ, Đống Đa, Hà Nội</p>
            </li>
            <li>
                <strong>Điện Thoại</strong>
                <p>+84 040 400 400</p>
            </li>
            <li>
                <strong>Email</strong>
                <p>FREEDOM@outlook.com</p>
            </li>
        </ul>
    </footer>

    <script>
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            Swal.fire({
                title: 'Email không tồn tại!',
                icon: 'error',
                showConfirmButton: false,
                timer: 1500
            });
        </text>
    }
    </script>
</body>
</html>