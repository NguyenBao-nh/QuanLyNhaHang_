@model QuanLyNhaHang_.Models.TaiKhoan
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Ký Tài Khoản</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            background-image: url(/Images/bg-dark.jpg);
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            box-sizing: border-box;
            font-family: "Poppins", sans-serif;
        }
        .container {
            display: block;
            position: relative;
            max-width: 450px;
            backdrop-filter: blur(3px);
            border: 1px solid #755c3d;
            border-radius: 15px;
            padding: 5.3em 2.5em 4em 2.5em;
            color: #755c3d;
            box-shadow: 0px 0px 10px 2px rgba(0, 0, 0, 0.2);
        }
        .signup-header {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #755c3d;
            width: 140px;
            height: 70px;
            border-radius: 0 0 20px 20px;
        }
        .signup-header span { font-size: 30px; color: #a77f44; font-weight: bold; }
        .form-control { border-radius: 50px; padding: 10px 15px; border: none; box-shadow: 0 0 8px gray; }
        #input-box { position: relative; display: flex; flex-direction: column; }
        .form-control:hover { background-color: #EDCF9F; }
        .icon { position: absolute; top: 10px; right: 20px; font-size: 20px; }
        .icon-toggle { cursor: pointer; user-select: none; }
        .signup_footer { width: fit-content; margin: 0 auto; padding: 8px 20px; }
        #buttondangky { background-color: #a77f44; border: none; padding: 8px 25px; border-radius: 15px; color: white; font-weight: bold; }
        #buttondangky:hover { box-shadow: 0px 0px 8px 8px #EDCF9F; }
        .register a { color: #EDCF9F; text-decoration: none; }
        .register a:hover { text-decoration: underline; }
        .form-label { color: black; }
        .text-danger { color: red; font-weight: bold; margin: 0; padding: 5px; }
    </style>
</head>
<body style="overflow:auto;">
    <div class="container mt-5 mb-5">
        <div class="signup-header">
            <span><a href="#" style="text-decoration: none; color:white">Sign Up</a></span>
        </div>

        <form asp-controller="Account" asp-action="DangKy" method="post" id="dangkyForm">
            <div class="mb-3">
                <label class="form-label">Tên đăng nhập:</label>
                <div id="input-box">
                    <input asp-for="Tendangnhap" class="form-control" placeholder="Enter username" id="signup-username" />
                    <span asp-validation-for="Tendangnhap" class="text-danger"></span>
                    <i class="bx bx-user icon"></i>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Mật khẩu:</label>
                <div id="input-box">
                    <input asp-for="Matkhau" type="password" class="form-control" placeholder="Enter password" id="signup-password" />
                    <span asp-validation-for="Matkhau" class="text-danger"></span>
                    <i class="bx bx-lock-alt icon icon-toggle" id="toggle-signup-password" role="button" tabindex="0" aria-label="Hiện/ẩn mật khẩu"></i>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu:</label>
                <div id="input-box">
                    <input asp-for="XacNhanMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu" id="signup-confirm" />
                    <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                    <i class="bx bx-lock-alt icon icon-toggle" id="toggle-signup-confirm" role="button" tabindex="0" aria-label="Hiện/ẩn mật khẩu"></i>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Email:</label>
                <div id="input-box">
                    <input asp-for="Email" type="email" class="form-control" placeholder="Enter email" id="signup-email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <i class="bx bx-envelope icon"></i>
                </div>
            </div>

            <div class="signup_footer">
                <button id="buttondangky" type="submit" class="btn btn-success">
                    Sign Up
                </button>
            </div>
            <div class="register mt-1 text-center">
                <span>Do you have an account? <a href="@Url.Action("DangNhap", "Account")">Login</a></span>
            </div>
        </form>
    </div>

    <script>
    // Nút xem/ẩn mật khẩu: bấm vào icon khóa để hiện chữ mật khẩu đang nhập
    function themNutXemMatKhau(iconId, inputId) {
        var icon = document.getElementById(iconId);
        var input = document.getElementById(inputId);
        if (!icon || !input) return;
        function toggle() {
            var dangAn = input.type === 'password';
            input.type = dangAn ? 'text' : 'password';
            icon.classList.toggle('bx-lock-alt', !dangAn);
            icon.classList.toggle('bx-lock-open-alt', dangAn);
        }
        icon.addEventListener('click', toggle);
        icon.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
        });
    }
    themNutXemMatKhau('toggle-signup-password', 'signup-password');
    themNutXemMatKhau('toggle-signup-confirm', 'signup-confirm');

    @if (TempData["SignSuccess"] != null)
    {
        var tiepTheo = TempData["SignNext"]?.ToString() == "DangNhap"
            ? Url.Action("DangNhap", "Account")
            : Url.Action("AConfirmEmail", "Account");
        <text>
            Swal.fire({
                title: 'Đăng ký thành công!',
                text: @Json.Serialize(TempData["SignText"]?.ToString() ?? ""),
                icon: 'success',
                confirmButtonText: 'OK'
            }).then(function () {
                window.location.href = @Json.Serialize(tiepTheo);
            });
        </text>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            Swal.fire({
                title: 'Đăng ký thất bại!',
                text: @Json.Serialize(TempData["ErrorMessage"]?.ToString() ?? ""),
                icon: 'error',
                confirmButtonText: 'OK'
            });
        </text>
    }
    @if (TempData["ErrorMessageSignup"] != null)
    {
        <text>
            Swal.fire({
                title: 'Tên đăng nhập đã tồn tại',
                icon: 'error',
                confirmButtonText: 'OK'
            });
        </text>
    }
    </script>
</body>
</html>