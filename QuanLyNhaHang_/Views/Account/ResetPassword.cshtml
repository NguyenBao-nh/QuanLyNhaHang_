@model QuanLyNhaHang_.Models.TaiKhoan
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt Lại Mật Khẩu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            background-image: url(/Images/bg-dark.jpg);
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
            background-attachment: fixed;
            box-sizing: border-box;
            font-family: "Poppins", sans-serif;
        }
        .container {
            display: block;
            position: relative;
            max-width: 450px;
            backdrop-filter: blur(3px);
            border: 1px solid #755c3d;
            border-radius: 15px;
            padding: 5.3em 2.5em 4em 2.5em;
            color: #755c3d;
            box-shadow: 0px 0px 10px 2px rgba(0, 0, 0, 0.2);
        }
        .form-control { border-radius: 50px; padding: 10px 15px; border: none; box-shadow: 0 0 8px gray; }
        #input-box { position: relative; display: flex; flex-direction: column; }
        .form-control:hover { background-color: #EDCF9F; }
        .icon { position: absolute; top: 10px; right: 20px; font-size: 20px; }
        .signup_footer { width: fit-content; margin: 0 auto; padding: 8px 20px; }
        #buttondangky { background-color: #a77f44; border: none; padding: 8px 25px; border-radius: 15px; color: white; font-weight: bold; }
        #buttondangky:hover { box-shadow: 0px 0px 8px 8px #EDCF9F; }
        .register a { color: #EDCF9F; text-decoration: none; }
        .register a:hover { text-decoration: underline; }
        .form-label { color: black; }
        .text-danger { color: red; font-weight: bold; margin: 0; padding: 5px; }
    </style>
</head>
<body style="overflow:auto;">
    <div class="container mt-5 mb-5">
        <form asp-controller="Account" asp-action="ResetPassword" method="post" id="doimatkhauForm">
            <div class="mb-3">
                <label class="form-label">Tên đăng nhập:</label>
                <div id="input-box">
                    <input asp-for="Tendangnhap" class="form-control" placeholder="Enter username" id="signup-username" required />
                    <span asp-validation-for="Tendangnhap" class="text-danger"></span>
                    <i class="bx bx-user icon"></i>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Nhập mật khẩu mới:</label>
                <div id="input-box">
                    <input asp-for="Matkhau" type="password" class="form-control" placeholder="Enter new password" id="signup-password" required />
                    <span asp-validation-for="Matkhau" class="text-danger"></span>
                    <i class="bx bx-lock-alt icon"></i>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu mới:</label>
                <div id="input-box">
                    <input asp-for="XacNhanMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu" id="signup-confirm" required />
                    <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                    <i class="bx bx-lock-alt icon"></i>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Mã xác minh (OTP):</label>
                <div id="input-box">
                    <input asp-for="Otp" type="number" class="form-control" placeholder="Enter OTP code" required />
                    <span asp-validation-for="Otp" class="text-danger"></span>
                    <i class="bx bx-mobile icon"></i>
                </div>
            </div>

            <div class="signup_footer">
                <button id="buttondangky" type="submit" class="btn btn-success">
                    Xác Nhận
                </button>
            </div>
            <div class="register mt-1 text-center">
                <span>Quay lại? <a href="@Url.Action("DangNhap", "Account")">Đăng Nhập</a></span>
            </div>
        </form>
    </div>

    <script>
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
            Swal.fire({
                title: 'Mật khẩu đổi thành công!',
                icon: 'success',
                showConfirmButton: false,
                timer: 1500
            }).then(function () {
                window.location.href = '@Url.Action("DangNhap", "Account")';
            });
        </text>
    }
    @if (TempData["SuccessMessageOTP"] != null)
    {
        <text>
            Swal.fire({
                title: 'Mã OTP đã được gửi cho bạn',
                icon: 'success',
                showConfirmButton: false,
                timer: 1500
            });
        </text>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            Swal.fire({
                title: 'Đổi mật khẩu thất bại!',
                icon: 'error',
                showConfirmButton: false,
                timer: 1500
            });
        </text>
    }
    @if (TempData["ErrorMessageOTP"] != null)
    {
        <text>
            Swal.fire({
                title: 'Tên đăng nhập hoặc mã OTP không chính xác',
                icon: 'error',
                showConfirmButton: false,
                timer: 1500
            });
        </text>
    }
    </script>
</body>
</html>