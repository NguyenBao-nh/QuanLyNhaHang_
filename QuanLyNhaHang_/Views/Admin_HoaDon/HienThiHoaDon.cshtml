@model IEnumerable<QuanLyNhaHang_.Models.PhieuNhapKho>

@{
    ViewData["Title"] = "Danh Sách Phiếu Nhập Kho";
    Layout = "~/Views/Shared/layout_admin.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Phiếu Nhập Kho</h2>
        <a href="@Url.Action("ThemHoaDon", "Admin_HoaDon")" class="btn btn-success btn-lg">
            <i class="bi bi-plus-circle"></i> Tạo Phiếu Nhập Kho Mới
        </a>
    </div>

    @if (TempData["ThanhCong"] != null)
    {
        <div class="alert alert-success">@TempData["ThanhCong"]</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover m-0">
                    <thead class="bg-primary text-white text-center">
                        <tr>
                            <th>Mã Nhập Kho</th>
                            <th>Mã Nhân Viên</th>
                            <th>Tên Nhân Viên</th>
                            <th>Ngày Nhập Kho</th>
                            <th>Tổng Tiền</th>
                            <th>Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-danger py-4">Không có phiếu nhập kho nào!</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr class="text-center">
                                    <td>@item.Manhapkho</td>
                                    <td>@item.Manv?.Trim()</td>
                                    <td>@(item.ManvNavigation?.Hoten ?? "-")</td>
                                    <td>@(item.Ngaynk.HasValue ? item.Ngaynk.Value.ToString("dd/MM/yyyy") : "")</td>
                                    <td>@String.Format("{0:N0} đ", item.Tongtien)</td>
                                    <td>
                                        <!-- Gọi chính xác tên Action viết hoa chữ C -->
                                        <a href="@Url.Action("ChiTietNhapKho", "Admin_HoaDon", new { MaNhapKho = item.Manhapkho })" class="btn btn-info btn-sm">
                                            <i class="bi bi-eye"></i> Chi Tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
