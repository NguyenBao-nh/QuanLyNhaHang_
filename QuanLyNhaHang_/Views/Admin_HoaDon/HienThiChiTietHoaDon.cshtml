@model IEnumerable<QuanLyNhaHang_.Models.ChiTietNhapKho>

@{
    ViewData["Title"] = "Chi Tiết Phiếu Nhập Kho";
    Layout = "~/Views/Shared/layout_admin.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Chi Tiết Phiếu Nhập Kho</h2>
        <a href="@Url.Action("HienThiHoaDon", "Admin_HoaDon")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay Lại Danh Sách
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover m-0">
                    <thead class="bg-primary text-white text-center">
                        <tr>
                            <th>Mã Nhập Kho</th>
                            <th>Mã Nguyên Liệu</th>
                            <th>Số Lượng</th>
                            <th>Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-danger py-4">Không có chi tiết nào!</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr class="text-center">
                                    <td>@item.Manhapkho</td>
                                    <td>@item.Manguyenlieu</td>
                                    <td>@item.Soluong</td>
                                    <td>@String.Format("{0:N0} đ", item.Thanhtien)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .btn {
        font-size: 14px;
    }

    .table th, .table td {
        vertical-align: middle;
        text-align: center;
        border: 1px solid #dee2e6;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }

    .bg-primary {
        background-color: #007bff !important;
    }

    .text-primary {
        font-weight: bold;
    }
</style>