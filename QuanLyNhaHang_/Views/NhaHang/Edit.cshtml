@model HoaDon
@{
    ViewData["Title"] = "Sửa Hóa Đơn";
    Layout = "~/Views/Shared/layout_admin.cshtml";
}

<div class="container mt-4" style="max-width: 600px">
    <h2 class="text-center mb-4" style="color: #fa8f23">Sửa Hóa Đơn @Model.Mahoadon.Trim()</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <form asp-action="Edit" asp-controller="NhaHang" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Mahoadon" />

        <div class="mb-3">
            <label asp-for="Maban" class="form-label">Mã bàn</label>
            <input asp-for="Maban" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Makh" class="form-label">Mã khách hàng</label>
            <input asp-for="Makh" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Manv" class="form-label">Mã nhân viên</label>
            <input asp-for="Manv" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Magiamgia" class="form-label">Mã giảm giá</label>
            <input asp-for="Magiamgia" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Ngaylap" class="form-label">Ngày lập</label>
            <input asp-for="Ngaylap" type="datetime-local" class="form-control" />
            <span asp-validation-for="Ngaylap" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Hinhthuc" class="form-label">Hình thức</label>
            <select asp-for="Hinhthuc" class="form-select">
                <option value="">-- Chọn --</option>
                <option value="Tiền mặt">Tiền mặt</option>
                <option value="Chuyển khoản">Chuyển khoản</option>
                <option value="Thẻ">Thẻ</option>
            </select>
        </div>
        <div class="d-flex justify-content-between">
            <a asp-action="ShowHD" class="btn btn-secondary">Quay lại</a>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </div>
    </form>
</div>
