@model IEnumerable<ChiTietHoaDon>
@{
    ViewData["Title"] = "Chi Tiết Hóa Đơn";
    Layout = "~/Views/Shared/layout_admin.cshtml";

    var hoaDon = (HoaDon)ViewBag.HoaDon;
    var khach = ViewBag.Khach as KhachHang;
    var danhGia = ViewBag.DanhGia as DanhGia;
    int tongMon = (int)ViewBag.Tong;
    int daThu = hoaDon.Tongtien ?? 0;
    int giam = Math.Max(0, tongMon - daThu);
}

<h2 class="text-center my-4 text-uppercase">Chi tiết hóa đơn - Mã: @ViewBag.MaHD</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
    </div>
}

<p class="text-end">
    <a asp-action="InHoaDon" asp-route-ma="@ViewBag.MaHD" asp-route-auto="1" target="_blank" class="btn btn-primary">
        <i class="bi bi-printer"></i> In hóa đơn
    </a>
    @if (ViewBag.VuaThanhToan == true)
    {
        <a asp-controller="PhieuGoiMon" asp-action="DanhSachPhieuGoiMon" class="btn btn-outline-secondary">
            <i class="bi bi-journal-text"></i> Về phiếu gọi món
        </a>
    }
    <a asp-action="ShowHD" asp-controller="NhaHang" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay Lại
    </a>
</p>

@if (hoaDon.LaDonTrucTuyen)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-globe2"></i> Đơn trực tuyến -
            trạng thái <span class="badge @TrangThaiDon.MauBadge(hoaDon.Trangthai)">@(hoaDon.Trangthai ?? "-")</span>
            @if (!string.IsNullOrWhiteSpace(hoaDon.Diachigiao)) { <span> · Giao đến: @hoaDon.Diachigiao</span> }
        </span>
        <a asp-controller="Admin_DonTrucTuyen" asp-action="ChiTiet" asp-route-ma="@ViewBag.MaHD" class="btn btn-sm btn-primary">Xác nhận đơn / giao</a>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header">
        <h4 class="mb-0">Thông Tin Hóa Đơn</h4>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-hover text-center">
            <tbody>
                <tr>
                    <td><strong>Mã hóa đơn:</strong> @ViewBag.MaHD</td>
                    <td><strong>Mã khách hàng:</strong> @(khach?.Makh.Trim() ?? "Vãng lai (không có tài khoản)")</td>
                </tr>
                <tr>
                    <td><strong>Bàn:</strong> @(string.IsNullOrWhiteSpace(hoaDon.Maban) ? (hoaDon.LaDonTrucTuyen ? "Đặt online" : "-") : hoaDon.Maban.Trim())</td>
                    <td><strong>Hình thức:</strong> @hoaDon.Hinhthuc</td>
                </tr>
                <tr>
                    <td><strong>Ngày lập:</strong> @hoaDon.Ngaylap</td>
                    <td><strong>Tên khách hàng:</strong> @hoaDon.TenHienThi @(string.IsNullOrWhiteSpace(hoaDon.Sdtkhach) ? "" : " · " + hoaDon.Sdtkhach.Trim())</td>
                </tr>
                <tr>
                    <td>
                        <strong>Mã nhân viên:</strong>
                        @if (string.IsNullOrWhiteSpace(hoaDon.Manv))
                        {
                            <span class="text-muted">Chưa có</span>
                        }
                        else
                        {
                            @hoaDon.Manv.Trim()
                        }
                    </td>
                    <td>
                        <strong>Đánh giá:</strong>
                        @if (string.IsNullOrWhiteSpace(danhGia?.Danhgia))
                        {
                            <span class="text-muted">Chưa có</span>
                        }
                        else
                        {
                            @danhGia.Danhgia
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow">
    <div class="card-header">
        <h4 class="mb-0">Danh Sách Món Ăn</h4>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã Món</th>
                        <th>Tên Món</th>
                        <th>Đơn Giá</th>
                        <th>Số Lượng</th>
                        <th>Thành Tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Mamonan.Trim()</td>
                            <td>@item.MamonanNavigation?.Tenmon</td>
                            <td>@((item.MamonanNavigation?.Gia ?? 0).ToString("N0")) VNĐ</td>
                            <td>@item.Soluong</td>
                            <td>@((item.Thanhtien ?? 0).ToString("N0")) VNĐ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="my-4 text-end">
    <h5><strong>Tổng tiền món:</strong> @tongMon.ToString("N0") VNĐ</h5>
    <h5><strong>Giảm giá:</strong> @giam.ToString("N0") VNĐ</h5>
    <h4><strong>Khách đã thanh toán:</strong> @daThu.ToString("N0") VNĐ</h4>
</div>
