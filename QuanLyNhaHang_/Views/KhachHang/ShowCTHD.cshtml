@model IEnumerable<ChiTietHoaDon>
@{
    Layout = null;

    var hoaDon = (HoaDon)ViewBag.HoaDon;
    var khach = ViewBag.Khach as KhachHang;
    var danhGia = ViewBag.DanhGia as DanhGia;
    int tongMon = (int)ViewBag.Tong;
    int daThu = hoaDon.Tongtien ?? 0;
    int giam = Math.Max(0, tongMon - daThu);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chi Tiết Hóa Đơn</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>
<body>
    <div class="container">
        <h2 class="text-center my-4 text-uppercase">Chi tiết hóa đơn - Mã: @ViewBag.MaHD</h2>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-success"><i class="bi bi-check-circle"></i> @TempData["ThongBao"]</div>
        }

        <p class="text-end">
            <a asp-action="InHoaDon" asp-controller="KhachHang" asp-route-ma="@ViewBag.MaHD" asp-route-auto="1" target="_blank" class="btn btn-warning">
                <i class="bi bi-printer"></i> In hóa đơn
            </a>
            <a asp-action="Menu" asp-controller="MonAn" class="btn btn-outline-secondary">
                <i class="bi bi-cup-hot"></i> Về Menu
            </a>
            <a asp-action="Profile" asp-controller="KhachHang" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Quay Lại
            </a>
        </p>

        <div class="card shadow mb-4">
            <div class="card-header"><h4 class="mb-0">Thông Tin Hóa Đơn</h4></div>
            <div class="card-body">
                <table class="table table-bordered table-hover text-center">
                    <tbody>
                        <tr>
                            <td><strong>Mã hóa đơn:</strong> @ViewBag.MaHD</td>
                            <td><strong>Mã khách hàng:</strong> @khach?.Makh.Trim()</td>
                        </tr>
                        <tr>
                            <td><strong>Bàn:</strong> @(string.IsNullOrWhiteSpace(hoaDon.Maban) ? "Chưa xếp bàn" : hoaDon.Maban.Trim())</td>
                            <td><strong>Hình thức:</strong> @hoaDon.Hinhthuc</td>
                        </tr>
                        <tr>
                            <td><strong>Ngày lập:</strong> @hoaDon.Ngaylap</td>
                            <td><strong>Tên khách hàng:</strong> @khach?.Hoten</td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Mã nhân viên:</strong>
                                @if (string.IsNullOrWhiteSpace(hoaDon.Manv)) { <span class="text-muted">Chưa có</span> }
                                else { @hoaDon.Manv.Trim() }
                            </td>
                            <td>
                                <strong>Đánh giá:</strong>
                                @if (string.IsNullOrWhiteSpace(danhGia?.Danhgia)) { <span class="text-muted">Chưa có</span> }
                                else { @danhGia.Danhgia }
                            </td>
                        </tr>
                        @if (hoaDon.LaDonTrucTuyen)
                        {
                            <tr>
                                <td>
                                    <strong>Trạng thái đơn:</strong>
                                    <span class="badge @TrangThaiDon.MauBadge(hoaDon.Trangthai)">@(hoaDon.Trangthai ?? "-")</span>
                                    @if (hoaDon.Trangthai?.Trim() == TrangThaiDon.ChoXacNhan)
                                    {
                                        <div class="small text-muted">Nhà hàng đang kiểm tra tiền chuyển khoản của bạn.</div>
                                    }
                                    @if (hoaDon.Trangthai?.Trim() == TrangThaiDon.DaHuy && !string.IsNullOrWhiteSpace(hoaDon.Lydohuy))
                                    {
                                        <div class="small text-danger">Lý do: @hoaDon.Lydohuy</div>
                                    }
                                </td>
                                <td>
                                    <strong>Nhận món:</strong>
                                    @(string.IsNullOrWhiteSpace(hoaDon.Maban) ? (hoaDon.Diachigiao ?? "-") : "Tại bàn " + hoaDon.Maban.Trim())
                                    @if (!string.IsNullOrWhiteSpace(hoaDon.Ghichu))
                                    {
                                        <div class="small text-muted">Ghi chú: @hoaDon.Ghichu</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow">
            <div class="card-header"><h4 class="mb-0">Danh Sách Món Ăn</h4></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover text-center align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Mã Món</th>
                                <th>Tên Món</th>
                                <th>Đơn Giá</th>
                                <th>Số Lượng</th>
                                <th>Thành Tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Mamonan.Trim()</td>
                                    <td>@item.MamonanNavigation?.Tenmon</td>
                                    <td>@((item.MamonanNavigation?.Gia ?? 0).ToString("N0")) VNĐ</td>
                                    <td>@item.Soluong</td>
                                    <td>@((item.Thanhtien ?? 0).ToString("N0")) VNĐ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="my-4 text-end">
            <h5><strong>Tổng tiền món:</strong> @tongMon.ToString("N0") VNĐ</h5>
            <h5><strong>Giảm giá:</strong> @giam.ToString("N0") VNĐ</h5>
            <h4><strong>Đã thanh toán:</strong> @daThu.ToString("N0") VNĐ</h4>
        </div>
    </div>
</body>
</html>
