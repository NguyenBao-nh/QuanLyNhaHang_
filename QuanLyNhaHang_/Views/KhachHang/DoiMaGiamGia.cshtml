@{
    Layout = null;
    bool coMa = ViewBag.RandomMaGiamGia != null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Đổi mã giảm giá</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <h2 class="text-center my-4 text-uppercase">Đổi mã giảm giá</h2>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        <form id="DoiMaGiamGiaForm" asp-action="XuLyDoiMa" asp-controller="KhachHang" method="post" onsubmit="return kiemTraKhiChonRadio()">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label for="MaKh">Mã Khách hàng:</label>
                        <input type="text" class="form-control" id="MaKh" value="@ViewBag.MaKH" readonly>
                    </div>
                    <div class="form-group mb-3">
                        <label for="HoTen">Họ tên:</label>
                        <input type="text" class="form-control" id="HoTen" value="@ViewBag.HoTen" readonly>
                    </div>
                    <div class="form-group mb-3">
                        <label for="Mail">Mail:</label>
                        <input type="text" class="form-control" id="Mail" value="@ViewBag.Mail" readonly>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label for="DiemThanhVien">Điểm thành viên:</label>
                        <input type="text" class="form-control" id="DiemThanhVien" value="@ViewBag.DiemThanhVien" readonly>
                    </div>
                    <div class="form-group mb-3">
                        <label>Mã giảm giá:</label>
                        <div>
                            @foreach (var soTien in new[] { 10000, 20000, 30000, 40000, 50000 })
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" id="MaGiamGia@(soTien)" name="MaGiamGia" value="@soTien" disabled>
                                    <label class="form-check-label" for="MaGiamGia@(soTien)">Mã giảm @soTien.ToString("N0")</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Đổi mã giảm giá</button>
            @if (!coMa)
            {
                <a asp-action="Profile" asp-controller="KhachHang" class="ms-2">Trở lại</a>
            }
        </form>

        @if (coMa)
        {
            <div class="container mt-4">
                <h4 class="text-center">Thông tin mã giảm giá</h4>

                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Mã giảm giá:</label>
                    <div class="col-sm-9"><input type="text" class="form-control" value="@ViewBag.RandomMaGiamGia" readonly></div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Số tiền:</label>
                    <div class="col-sm-9"><input type="text" class="form-control" value="@(((int)ViewBag.SoTien).ToString("N0"))" readonly></div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Ngày bắt đầu:</label>
                    <div class="col-sm-9"><input type="text" class="form-control" value="@(((DateTime)ViewBag.NgayBD).ToString("dd/MM/yyyy"))" readonly></div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label">Ngày kết thúc:</label>
                    <div class="col-sm-9"><input type="text" class="form-control" value="@(((DateTime)ViewBag.NgayKT).ToString("dd/MM/yyyy"))" readonly></div>
                </div>

                <div class="text-center">
                    <a asp-action="Profile" asp-controller="KhachHang" class="btn btn-secondary">Trở lại</a>
                </div>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Chỉ bật các mức giảm mà khách đủ điểm để đổi
        function kichHoatRadioButtons() {
            var diem = parseInt(document.getElementById("DiemThanhVien").value) || 0;
            document.getElementsByName("MaGiamGia").forEach(function (r) {
                r.disabled = parseInt(r.value) > diem;
            });
        }

        function kiemTraKhiChonRadio() {
            var diem = parseInt(document.getElementById("DiemThanhVien").value) || 0;
            var chon = document.querySelector("input[name='MaGiamGia']:checked");
            if (!chon) { alert("Vui lòng chọn mã giảm giá."); return false; }
            if (diem < parseInt(chon.value)) { alert("Điểm thành viên không đủ để đổi mã giảm giá."); return false; }
            return true;
        }

        window.addEventListener("load", kichHoatRadioButtons);
    </script>
</body>
</html>

