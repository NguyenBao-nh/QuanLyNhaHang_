@model List<CaLamViec>
@{
    ViewData["Title"] = "Lịch Sử Ca";
    Layout = "~/Views/Shared/layout_admin.cshtml";
    int thang = ViewBag.Thang is int t ? t : DateTime.Today.Month;
    int nam = ViewBag.Nam is int n ? n : DateTime.Today.Year;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="color:#fa8f23">Lịch Sử Ca / Phiếu Đóng Ca</h2>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Ca hiện tại</a>
    </div>

    @if (TempData["LoiCa"] != null)
    {
        <div class="alert alert-danger">@TempData["LoiCa"]</div>
    }

    <form asp-action="LichSu" method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <select name="thang" class="form-select">
                @for (int m = 1; m <= 12; m++)
                {
                    if (m == thang) { <option value="@m" selected>Tháng @m</option> }
                    else { <option value="@m">Tháng @m</option> }
                }
            </select>
        </div>
        <div class="col-auto">
            <select name="nam" class="form-select">
                @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 5; y--)
                {
                    if (y == nam) { <option value="@y" selected>@y</option> }
                    else { <option value="@y">@y</option> }
                }
            </select>
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-primary">Xem</button></div>
    </form>

    <div class="card"><div class="card-body table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mã ca</th><th>Ngày</th><th>Ca</th><th>Mở / đóng</th><th>Nhân viên</th>
                    <th class="text-end">Đầu ca</th><th class="text-end">Doanh thu</th><th class="text-end">Chi + rút</th>
                    <th class="text-end">Két cuối</th><th class="text-end">Thực tế</th><th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted">Không có ca nào trong tháng.</td></tr>
                }
                @foreach (var c in Model)
                {
                    int? lech = c.Tienthucte != null && c.Tienketcuoi != null ? c.Tienthucte - c.Tienketcuoi : null;
                    <tr>
                        <td>@c.Maca.Trim()</td>
                        <td>@c.Ngay.ToString("dd/MM/yyyy")</td>
                        <td>@c.Loaica</td>
                        <td class="small">@c.Tgmo.ToString("HH:mm") - @(c.Tgdong?.ToString("HH:mm") ?? "...")</td>
                        <td class="small">@c.Tennvmo @(c.Tennvdong != null && c.Tennvdong != c.Tennvmo ? " / " + c.Tennvdong : "")</td>
                        <td class="text-end">@c.Tiendauca.ToString("N0")</td>
                        <td class="text-end">@(c.Doanhthu?.ToString("N0") ?? "-")</td>
                        <td class="text-end">@(c.Tongchi == null ? "-" : ((c.Tongchi ?? 0) + (c.Tongrut ?? 0)).ToString("N0"))</td>
                        <td class="text-end fw-semibold">@(c.Tienketcuoi?.ToString("N0") ?? "-")</td>
                        <td class="text-end">
                            @(c.Tienthucte?.ToString("N0") ?? "-")
                            @if (lech != null && lech != 0)
                            {
                                <div class="small @(lech < 0 ? "text-danger" : "text-success")">lệch @(lech > 0 ? "+" : "")@lech.Value.ToString("N0")</div>
                            }
                        </td>
                        <td>
                            @if (c.DangMo)
                            {
                                <span class="badge bg-success">Đang mở</span>
                            }
                            else
                            {
                                <a asp-action="PhieuDongCa" asp-route-ma="@c.Maca.Trim()" asp-route-auto="1" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-printer"></i> In phiếu
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
</div>
