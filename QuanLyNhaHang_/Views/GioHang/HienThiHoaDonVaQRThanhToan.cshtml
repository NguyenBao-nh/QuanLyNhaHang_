@model QuanLyNhaHang_.Models.ViewThanhToan

@{
    ViewData["Title"] = "Hóa Đơn & Thanh Toán QR";
    Layout = "~/Views/Shared/layout_user.cshtml";
    bool taiBan = !string.IsNullOrEmpty(Model.HoaDon.Maban);
    bool batBuocAnh = ViewBag.BatBuocAnhCK is bool bb ? bb : true;
}

<!-- Start Page Title Area -->
<div class="page-title-area">
    <div class="d-table">
        <div class="d-table-cell">
            <div class="container">
                <div class="page-title-content">
                    <h2>Thanh toán</h2>
                    <ul>
                        <li><a href="@Url.Action("Welcome", "Account")">Trang Chủ</a></li>
                        <li>Thanh toán</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Page Title Area -->

<div class="container mt-5 mb-5">
    <div class="row d-flex justify-content-center align-items-center">
        <!-- Danh sách sản phẩm (Bên trái) -->
        <div class="col-md-6">
            <h3 class="mb-4 text-center">Thông tin hóa đơn</h3>
            <div class="mb-4">
                <strong>Mã hóa đơn: </strong>@Model.HoaDon.Mahoadon<br>
                <strong>Ngày lập: </strong>@(Model.HoaDon.Ngaylap.HasValue ? Model.HoaDon.Ngaylap.Value.ToString("dd/MM/yyyy HH:mm") : "")<br>
                <strong>Bàn: </strong>@(string.IsNullOrEmpty(Model.HoaDon.Maban) ? "Chưa xếp bàn" : Model.HoaDon.Maban.Trim())<br>
                <strong>Mã khách hàng: </strong>@Model.HoaDon.Makh<br>
                <strong>Tên khách hàng: </strong>@(ViewBag.TenKhachHang ?? Model.HoaDon.Makh)<br>
                <strong>Phương thức thanh toán: </strong>@Model.HoaDon.Hinhthuc<br>
                <strong>Mã giảm giá: </strong>@Model.HoaDon.Magiamgia<br>
            </div>

            <h3 class="mb-4 text-center">Danh sách sản phẩm</h3>
            <table class="table table-bordered">
                <thead class="thead-light">
                    <tr>
                        <th>Mã món</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ChiTietHoaDonList != null)
                    {
                        @foreach (var item in Model.ChiTietHoaDonList)
                        {
                            <tr>
                                <td>@item.Mamonan</td>
                                <td>@item.Soluong</td>
                                <td>@String.Format("{0:N0}", item.Thanhtien) ₫</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            
            <div class="text-right font-weight-bold mt-3" style="font-size:1.25rem">
                Tổng cộng:
                <span class="text-danger">
                    @String.Format("{0:N0}", Model.SoTienSauGiamGia) ₫
                    @if (Model.TongTien != Model.SoTienSauGiamGia)
                    {
                        <span style="text-decoration: line-through; margin-left: 10px; color: #888; font-size: 0.9em;">
                            @String.Format("{0:N0}", Model.TongTien) ₫
                        </span>
                    }
                </span>
            </div>
        </div>

        <!-- QR Thanh toán (Bên phải) -->
        <div class="col-md-4">
            <h3 class="mb-4 text-center">QR Thanh Toán</h3>
            <p class="text-muted text-center">Quét mã để thanh toán hóa đơn</p>
            <img src="~/images/maQR.jpg"
                 alt="QR Thanh Toán"
                 class="img-fluid rounded mx-auto d-block mb-3">
            <p class="mt-3 text-center">
                <strong>Ngân hàng: VietinBank</strong><br />
                Số tài khoản: <strong>109882288378</strong><br />
                Tên tài khoản: <strong>BUI HAI ANH</strong><br />
                Nội dung CK: <strong>@Model.HoaDon.Mahoadon</strong>
            </p>

            <!-- Form gửi thông tin xác nhận thanh toán -->
            <div class="alert alert-warning text-left" style="font-size:14px">
                <strong>Thanh toán trước 100%:</strong> đơn đặt trực tuyến chỉ được nhà hàng xử lý sau khi
                <strong>đã nhận đủ tiền chuyển khoản</strong>. Vui lòng chuyển đúng số tiền
                <strong>@String.Format("{0:N0}", Model.SoTienSauGiamGia) ₫</strong> với nội dung <strong>@Model.HoaDon.Mahoadon</strong>,
                rồi tải ảnh chụp giao dịch bên dưới.
            </div>

            <form method="post" action="@Url.Action("DaThanhToan", "GioHang")" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaHoaDon" value="@Model.HoaDon.Mahoadon" />
                <input type="hidden" name="MaKH" value="@Model.HoaDon.Makh" />
                <input type="hidden" name="TongTien" value="@Model.TongTien" />
                <input type="hidden" name="HinhThuc" value="@Model.HoaDon.Hinhthuc" />
                <input type="hidden" name="MaGiamGia" value="@Model.HoaDon.Magiamgia" />
                <input type="hidden" name="SauGiam" value="@Model.SoTienSauGiamGia" />

                @* Thông tin nhận món - nhà hàng dùng để xác nhận đơn / giao món *@
                <div class="card mt-3 text-left">
                    <div class="card-body">
                        <h5 class="mb-3">Thông tin nhận món</h5>
                        @if (ViewBag.LoiNhanMon != null)
                        {
                            <div class="alert alert-danger py-2">@ViewBag.LoiNhanMon</div>
                        }
                        @if (taiBan)
                        {
                            <p class="mb-2 text-success"><strong>Phục vụ tại bàn @Model.HoaDon.Maban!.Trim()</strong> (bạn đang ngồi ở bàn này).</p>
                        }
                        <div class="form-group mb-2">
                            <label for="SdtNhan">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" id="SdtNhan" name="SdtNhan" class="form-control" required pattern="[0-9]{9,11}"
                                   maxlength="11" value="@ViewBag.SoDT" placeholder="VD: 0912345678" />
                        </div>
                        @if (!taiBan)
                        {
                            <div class="form-group mb-2">
                                <label for="DiaChiGiao">Địa chỉ giao hàng <span class="text-danger">*</span></label>
                                <input type="text" id="DiaChiGiao" name="DiaChiGiao" class="form-control" required maxlength="200"
                                       value="@ViewBag.DiaChi" placeholder="Số nhà, đường, phường, quận..." />
                            </div>
                        }
                        <div class="form-group mb-2">
                            <label for="AnhChuyenKhoan">Ảnh chụp giao dịch chuyển khoản @if (batBuocAnh) { <span class="text-danger">*</span> }</label>
                            <input type="file" id="AnhChuyenKhoan" name="AnhChuyenKhoan" class="form-control-file"
                                   accept="image/jpeg,image/png,image/webp" @(batBuocAnh ? "required" : "") />
                            <small class="text-muted">JPG, PNG, WEBP - tối đa 5 MB.</small>
                        </div>
                        <div class="form-group mb-2">
                            <label for="MaGiaoDich">Mã giao dịch ngân hàng (nếu có)</label>
                            <input type="text" id="MaGiaoDich" name="MaGiaoDich" class="form-control" maxlength="50"
                                   value="@ViewBag.MaGiaoDich" placeholder="VD: FT2631112345678" />
                        </div>
                        <div class="form-group mb-0">
                            <label for="GhiChu">Ghi chú cho nhà hàng</label>
                            <textarea id="GhiChu" name="GhiChu" class="form-control" rows="2" maxlength="300"
                                      placeholder="VD: ít cay, giao giờ trưa...">@ViewBag.GhiChu</textarea>
                        </div>
                    </div>
                </div>

                @if (Model.ChiTietHoaDonList != null)
                {
                    int index = 0;
                    foreach (var item in Model.ChiTietHoaDonList)
                    {
                        <input type="hidden" name="ChiTietHoaDon[@index].MaMon" value="@item.Mamonan" />
                        <input type="hidden" name="ChiTietHoaDon[@index].SoLuong" value="@item.Soluong" />
                        <input type="hidden" name="ChiTietHoaDon[@index].ThanhTien" value="@item.Thanhtien" />
                        index++;
                    }
                }

                <button type="submit" class="btn btn-success mt-3 w-100 font-weight-bold py-2">Tôi Đã Chuyển Khoản - Gửi Đơn</button>
            </form>
        </div>
    </div>
</div>