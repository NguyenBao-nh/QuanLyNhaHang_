@model List<MonAn>

@foreach (var monAn in Model)
{
    <div class="single-box-menu">
        <div class="food-image" style="width:100px; height:100px;">
            <img style="width:100%; height:100%; object-fit:cover"
                 src="@Url.Content("~/Images/MonAn/" + monAn.AnhMon)" alt="@monAn.Tenmon" onerror="this.onerror=null;this.src='/Images/logo.png';" />
        </div>
        <div class="menu-content">
            <h4>@monAn.Tenmon <span class="price">@((monAn.Gia ?? 0).ToString("N0")) đ</span></h4>
            <div style="display:flex; align-items:center; justify-content:space-between">
                <p style="max-width:850px">@monAn.MoTa</p>

                <i style="font-size: 30px; color: #ff8d25; margin-right:20px; cursor: pointer;"
                   class="fa-solid fa-circle-plus"
                   onclick="addToCart('@monAn.Mamonan.Trim()', 1)"></i>
            </div>
        </div>
    </div>
}
