@model IEnumerable<QuanLyNhaHang_.Models.ChiTietXuatKhoViewModel>
@{
    ViewData["Title"] = "Chi Tiết Xuất Kho";
    Layout = "~/Views/Shared/layout_admin.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Chi Tiết Phiếu Xuất Kho</h2>
        <a asp-action="HienThiXuatKho" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay Lại
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover bg-white shadow-sm">
            <thead class="bg-primary text-white text-center">
                <tr>
                    <th>Mã Xuất Kho</th>
                    <th>Mã Nguyên Liệu</th>
                    <th>Tên Nguyên Liệu</th>
                    <th>Số Lượng</th>
                    <th>Thành Tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-danger py-3">Không có chi tiết xuất kho nào!</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr class="text-center">
                            <td class="fw-bold">@item.MaXuatKho</td>
                            <td>@item.MaNguyenLieu</td>
                            <td class="text-start">@item.TenNguyenLieu</td>
                            <td>@item.SoLuong</td>
                            <td class="text-end">@String.Format("{0:N0} đ", item.ThanhTien)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .table th, .table td {
        vertical-align: middle;
        border: 1px solid #dee2e6;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }

    .text-primary {
        font-weight: bold;
        color: #0d6efd !important;
    }
</style>