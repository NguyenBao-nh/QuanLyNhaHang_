@model QuanLyNhaHang_.Models.ThemPhieuXuatKhoViewModel
@{
    ViewData["Title"] = "Thêm Phiếu Xuất Kho";
    Layout = "~/Views/Shared/layout_admin.cshtml";

    var ngay = (Model.NgayXuatKho ?? DateTime.Now)
        .ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);

    // Các dòng đã nhập (khi server báo lỗi và hiển thị lại form)
    var dongDaNhap = Model.ChiTiet
        .Select(c => new { ma = (c.Manguyenlieu ?? "").Trim(), sl = c.Soluong })
        .ToList();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Tạo Phiếu Xuất Kho</h2>
        <a href="@Url.Action("HienThiXuatKho", "Admin_XuatKho")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay Lại Danh Sách
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-controller="Admin_XuatKho" asp-action="ThemPhieuXuatKho" id="phieuForm">

        <!-- ===== Thông tin chung của phiếu ===== -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Thông Tin Phiếu</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 col-12 mb-3">
                        <label for="MaNV" class="form-label">Nhân Viên Lập Phiếu</label>
                        @if (Model.MaNVSession != null)
                        {
                            <input type="text" id="MaNV" name="MaNV" class="form-control"
                                   value="@Model.MaNVSession" readonly />
                        }
                        else
                        {
                            <select id="MaNV" name="MaNV" class="form-select" required>
                                <option value="">-- Chọn nhân viên --</option>
                                @foreach (var nv in Model.NhanViens)
                                {
                                    <option value="@nv.Ma" selected="@(nv.Ma == Model.MaNV)">@nv.Ma - @nv.HoTen</option>
                                }
                            </select>
                        }
                    </div>

                    <div class="col-md-4 col-12 mb-3">
                        <label for="MaXuatKho" class="form-label">Mã Phiếu Xuất</label>
                        <!-- Mã do hệ thống tự sinh; server sinh lại khi lưu để không bao giờ bị trùng -->
                        <input type="text" id="MaXuatKho" name="MaXuatKho" class="form-control"
                               value="@Model.MaXuatKho" readonly />
                    </div>

                    <div class="col-md-4 col-12 mb-3">
                        <label for="NgayXuatKho" class="form-label">Ngày Xuất</label>
                        <input type="datetime-local" id="NgayXuatKho" name="NgayXuatKho"
                               class="form-control" value="@ngay" required />
                    </div>
                </div>
            </div>
        </div>

        <!-- ===== Chi tiết phiếu ===== -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Chi Tiết Phiếu Xuất Kho</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead>
                            <tr class="text-center">
                                <th style="min-width:260px">Nguyên Liệu</th>
                                <th style="width:120px">Tồn Kho</th>
                                <th style="width:140px">Số Lượng Xuất</th>
                                <th style="width:110px">Đơn Vị Tính</th>
                                <th style="width:150px">Đơn Giá</th>
                                <th style="width:170px">Thành Tiền</th>
                                <th style="width:80px">Xóa</th>
                            </tr>
                        </thead>
                        <tbody id="productRows"></tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" class="text-end fw-bold">Tổng tiền:</td>
                                <td colspan="2" class="fw-bold text-danger" id="tongTien">0 đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <button type="button" class="btn btn-dark" id="addNewRow">
                    <i class="bi bi-plus-circle"></i> Thêm Dòng Mới
                </button>
            </div>
        </div>

        <div class="text-end mb-4">
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-save"></i> Lưu Phiếu Xuất Kho
            </button>
        </div>
    </form>
</div>

<!-- Mẫu 1 dòng chi tiết (tên field được đánh chỉ số đúng khi submit) -->
<template id="rowTemplate">
    <tr>
        <td>
            <select class="form-select ma-nl" required>
                <option value="">-- Chọn nguyên liệu --</option>
                @foreach (var nl in Model.NguyenLieus)
                {
                    <option value="@nl.Ma" data-dvt="@nl.Dvt" data-dongia="@nl.DonGia" data-ton="@nl.Ton">@nl.Ma - @nl.Ten</option>
                }
            </select>
        </td>
        <td><input type="text" class="form-control ton text-end" readonly tabindex="-1" /></td>
        <td><input type="number" class="form-control so-luong" min="1" step="1" placeholder="Số lượng" required /></td>
        <td><input type="text" class="form-control dvt" readonly tabindex="-1" /></td>
        <td><input type="text" class="form-control don-gia text-end" readonly tabindex="-1" /></td>
        <td><input type="text" class="form-control thanh-tien text-end" readonly tabindex="-1" /></td>
        <td class="text-center">
            <button type="button" class="btn btn-outline-danger btn-sm btn-xoa" title="Xóa dòng">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('phieuForm');
            const tbody = document.getElementById('productRows');
            const tpl = document.getElementById('rowTemplate');
            const tongEl = document.getElementById('tongTien');
            const fmt = n => Number(n || 0).toLocaleString('vi-VN');
            const dongDaNhap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dongDaNhap));

            // Tính 1 dòng, trả về thành tiền của dòng đó
            function tinhDong(tr) {
                const sel = tr.querySelector('.ma-nl');
                const opt = sel.value ? sel.selectedOptions[0] : null;
                const donGia = opt ? Number(opt.dataset.dongia || 0) : 0;
                const ton = opt ? Number(opt.dataset.ton || 0) : 0;
                const soLuongEl = tr.querySelector('.so-luong');
                const soLuong = parseFloat(soLuongEl.value) || 0;

                tr.querySelector('.dvt').value = opt ? (opt.dataset.dvt || '') : '';
                tr.querySelector('.ton').value = opt ? fmt(ton) : '';
                tr.querySelector('.don-gia').value = opt ? fmt(donGia) : '';
                tr.querySelector('.thanh-tien').value = opt ? fmt(soLuong * donGia) : '';

                // Chặn nhập vượt tồn kho ngay trên form (server vẫn kiểm tra lại)
                if (opt) {
                    soLuongEl.max = ton;
                    soLuongEl.setCustomValidity(soLuong > ton ? ('Chỉ còn tồn ' + ton) : '');
                } else {
                    soLuongEl.removeAttribute('max');
                    soLuongEl.setCustomValidity('');
                }
                return soLuong * donGia;
            }

            function tinhTong() {
                let tong = 0;
                tbody.querySelectorAll('tr').forEach(tr => { tong += tinhDong(tr); });
                tongEl.textContent = fmt(tong) + ' đ';
            }

            function themDong(ma, soLuong) {
                const tr = tpl.content.firstElementChild.cloneNode(true);
                if (ma) tr.querySelector('.ma-nl').value = ma;
                if (soLuong) tr.querySelector('.so-luong').value = soLuong;
                tbody.appendChild(tr);
                tinhTong();
            }

            tbody.addEventListener('change', tinhTong);
            tbody.addEventListener('input', tinhTong);

            // Xóa dòng (luôn giữ lại ít nhất 1 dòng)
            tbody.addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-xoa');
                if (!btn) return;
                const tr = btn.closest('tr');
                if (tbody.querySelectorAll('tr').length > 1) {
                    tr.remove();
                } else {
                    tr.querySelector('.ma-nl').value = '';
                    tr.querySelector('.so-luong').value = '';
                }
                tinhTong();
            });

            document.getElementById('addNewRow').addEventListener('click', function () {
                themDong();
            });

            // Trước khi gửi: đánh chỉ số ChiTiet[0], ChiTiet[1], ... để ASP.NET Core bind được List
            form.addEventListener('submit', function () {
                tbody.querySelectorAll('tr').forEach(function (tr, i) {
                    tr.querySelector('.ma-nl').name = 'ChiTiet[' + i + '].Manguyenlieu';
                    tr.querySelector('.so-luong').name = 'ChiTiet[' + i + '].Soluong';
                });
            });

            if (dongDaNhap.length) {
                dongDaNhap.forEach(d => themDong(d.ma, d.sl));
            } else {
                themDong();
            }
        })();
    </script>
}
